# ═══════════════════════════════════════════
# ENVIRONMENT VARIABLES — .env.example
# Copy this file to .env.local and fill in
# the real values. Never commit .env.local.
# ═══════════════════════════════════════════

# ── Email (Resend) ────────────────────────
# Sign up at https://resend.com, get API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your email address to receive contact form submissions
CONTACT_TO_EMAIL=your.email@example.com

# ── GitHub (optional, increases rate limit) ─
# Create a personal access token at GitHub → Settings → Developer settings
# Only needs 'public_repo' read scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Redis / Upstash (optional, for persistent visitor counter) ─
# Sign up at https://upstash.com
UPSTASH_REDIS_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_TOKEN=YOUR_REDIS_TOKEN

# ── App ───────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
